{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://tradeops.local/schemas/events/orders/order.partially_filled.v1.json",
  "title": "order.partially_filled v1",
  "type": "object",
  "additionalProperties": true,
  "required": ["eventId", "eventType", "tenantId", "orderId", "userId", "symbol", "quantity", "filledQuantity", "remainingQuantity", "status"],
  "properties": {
    "eventId": { "type": "string" },
    "eventType": { "type": "string", "enum": ["order.partially_filled"] },
    "eventVersion": { "type": "string" },
    "tenantId": { "type": "string" },
    "correlationId": { "type": "string" },
    "traceparent": { "type": "string" },
    "occurredAt": { "type": "string", "format": "date-time" },
    "orderId": { "type": "string" },
    "userId": { "type": "string" },
    "symbol": { "type": "string" },
    "side": { "type": "string", "enum": ["BUY", "SELL"] },
    "orderType": { "type": "string" },
    "timeInForce": { "type": "string" },
    "quantity": { "type": "number" },
    "filledQuantity": { "type": "number" },
    "remainingQuantity": { "type": "number" },
    "averageFillPrice": { "type": "number" },
    "status": { "type": "string", "enum": ["partially_filled"] },
    "version": { "type": "integer" }
  }
}
