{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://tradeops.local/schemas/events/orders/order.expired.v1.json",
  "title": "order.expired v1",
  "type": "object",
  "additionalProperties": true,
  "required": ["eventId", "eventType", "tenantId", "orderId", "userId", "symbol", "status"],
  "properties": {
    "eventId": { "type": "string" },
    "eventType": { "type": "string", "enum": ["order.expired"] },
    "eventVersion": { "type": "string" },
    "tenantId": { "type": "string" },
    "correlationId": { "type": "string" },
    "occurredAt": { "type": "string", "format": "date-time" },
    "orderId": { "type": "string" },
    "userId": { "type": "string" },
    "symbol": { "type": "string" },
    "remainingQuantity": { "type": "number" },
    "status": { "type": "string", "enum": ["expired"] },
    "version": { "type": "integer" }
  }
}
